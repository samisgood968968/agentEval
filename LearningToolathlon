#### 方法 2: 使用 Python 脚本对比

**对比脚本** (`compare_models.py`):

```python
#!/usr/bin/env python3
"""
对比多个模型在 Toolathlon 基准上的表现
"""

import json
import sys
from pathlib import Path
from typing import List, Dict, Any

def load_eval_stats(model_dir: Path) -> Dict[str, Any]:
    """加载单个模型的评估统计"""
    stats_file = model_dir / "eval_stats.json"
    if not stats_file.exists():
        return None
    
    with open(stats_file, 'r') as f:
        return json.load(f)

def compare_models(base_dir: str) -> List[Dict[str, Any]]:
    """对比多个模型的结果"""
    base_path = Path(base_dir)
    
    if not base_path.exists():
        print(f"Error: Directory not found: {base_dir}")
        sys.exit(1)
    
    results = []
    
    # 遍历所有模型目录
    for model_dir in sorted(base_path.iterdir()):
        if not model_dir.is_dir():
            continue
        
        stats = load_eval_stats(model_dir)
        if stats is None:
            continue
        
        model_name = model_dir.name
        
        # 提取关键指标
        result = {
            'model': model_name,
            'total': stats['total_tasks'],
            'passed': stats['status_breakdown']['evaluation']['pass_count'],
            'failed': stats['status_breakdown']['evaluation']['fail_count'],
            'not_evaluated': stats['status_breakdown']['evaluation']['null_count'],
            'success_rate': stats['average_success_rate'] * 100,
            'avg_turns': stats['average_turns'],
            'avg_tool_calls': stats['average_tool_calls'],
        }
        
        results.append(result)
    
    # 按成功率降序排序
    results.sort(key=lambda x: x['success_rate'], reverse=True)
    
    return results

def print_comparison(results: List[Dict[str, Any]]):
    """打印对比结果"""
    print("=" * 120)
    print("Multi-Model Comparison on Toolathlon Benchmark")
    print("=" * 120)
    print()
    
    # 打印表头
    header = f"{'Model':<30} | {'Total':>6} | {'Passed':>6} | {'Failed':>6} | {'Not Eval':>8} | {'Rate':>8} | {'Avg Turns':>10} | {'Avg Tools':>10}"
    print(header)
    print("-" * 120)
    
    # 打印每个模型的结果
    for result in results:
        line = (
            f"{result['model']:<30} | "
            f"{result['total']:>6} | "
            f"{result['passed']:>6} | "
            f"{result['failed']:>6} | "
            f"{result['not_evaluated']:>8} | "
            f"{result['success_rate']:>7.2f}% | "
            f"{result['avg_turns']:>10.2f} | "
            f"{result['avg_tool_calls']:>10.2f}"
        )
        print(line)
    
    print("=" * 120)
    print()
    
    # 打印排名前三
    print("Top 3 Models:")
    for i, result in enumerate(results[:3], 1):
        print(f"  {i}. {result['model']}: {result['success_rate']:.2f}% ({result['passed']}/{result['total']})")
    print()

def export_to_csv(results: List[Dict[str, Any]], output_file: str):
    """导出结果到 CSV 文件"""
    import csv
    
    with open(output_file, 'w', newline='') as f:
        writer = csv.DictWriter(f, fieldnames=[
            'model', 'total', 'passed', 'failed', 'not_evaluated',
            'success_rate', 'avg_turns', 'avg_tool_calls'
        ])
        writer.writeheader()
        writer.writerows(results)
    
    print(f"Results exported to: {output_file}")

def main():
    if len(sys.argv) < 2:
        print("Usage: python compare_models.py <dumps_directory> [--csv output.csv]")
        print("Example: python compare_models.py dumps_finalexp/ --csv comparison.csv")
        sys.exit(1)
    
    base_dir = sys.argv[1]
    results = compare_models(base_dir)
    
    if not results:
        print("No evaluation results found in the specified directory.")
        sys.exit(1)
    
    print_comparison(results)
    
    # 检查是否需要导出 CSV
    if '--csv' in sys.argv:
        csv_index = sys.argv.index('--csv')
        if csv_index + 1 < len(sys.argv):
            output_file = sys.argv[csv_index + 1]
            export_to_csv(results, output_file)

if __name__ == '__main__':
    main()
```

