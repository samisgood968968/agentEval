### 生成分析报告

#### 综合分析脚本

创建完整的分析脚本 `analyze_results.sh`：

```bash
#!/bin/bash

DUMP_PATH="${1:-./dumps_full_eval}"

echo "=========================================="
echo "    Toolathlon Results Analysis"
echo "=========================================="
echo ""

# 1. 整体统计
echo "1. Overall Statistics"
echo "--------------------"
cat "$DUMP_PATH/eval_stats.json" | jq '{
  total_tasks: .total_tasks,
  passed: .status_breakdown.evaluation.pass_count,
  failed: .status_breakdown.evaluation.fail_count,
  not_evaluated: .status_breakdown.evaluation.null_count,
  success_rate: (.average_success_rate * 100 | tostring + "%"),
  avg_turns: .average_turns,
  avg_tool_calls: .average_tool_calls
}'
echo ""

# 2. 各阶段统计
echo "2. Stage Breakdown"
echo "------------------"
echo "Preprocessing:"
cat "$DUMP_PATH/eval_stats.json" | jq '.status_breakdown.preprocess | {
  done: .done_count,
  fail: .fail_count,
  timeout: .timeout_count
}'
echo ""
echo "Running:"
cat "$DUMP_PATH/eval_stats.json" | jq '.status_breakdown.running | {
  done: .done_count,
  fail: .fail_count,
  timeout: .timeout_count,
  max_turns: .max_turns_count
}'
echo ""

# 3. 失败任务列表
echo "3. Failed Tasks"
echo "---------------"
echo "Evaluation failed:"
cat "$DUMP_PATH/eval_stats.json" | jq -r '.status_breakdown.evaluation.fail_tasks[]' | head -10
if [ $(cat "$DUMP_PATH/eval_stats.json" | jq -r '.status_breakdown.evaluation.fail_tasks | length') -gt 10 ]; then
    echo "... ($(cat "$DUMP_PATH/eval_stats.json" | jq -r '.status_breakdown.evaluation.fail_tasks | length') total)"
fi
echo ""

# 4. Token 使用统计
echo "4. Token Usage"
echo "--------------"
jq -r '.agent_cost | "\(.prompt_tokens) \(.completion_tokens)"' \
  "$DUMP_PATH/traj_log_all.jsonl" | \
  awk '{
    prompt_sum += $1
    completion_sum += $2
    count++
  }
  END {
    printf "Total prompt tokens: %d\n", prompt_sum
    printf "Total completion tokens: %d\n", completion_sum
    printf "Average prompt tokens: %.0f\n", prompt_sum / count
    printf "Average completion tokens: %.0f\n", completion_sum / count
  }'
echo ""

echo "=========================================="
echo "Analysis complete. For detailed task analysis, check individual traj_log.json files."
```

