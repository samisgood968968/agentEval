#!/usr/bin/env python3
"""
生成 Toolathlon 模型排行榜（Markdown 格式）
"""

import json
import sys
from pathlib import Path
from datetime import datetime
from typing import List, Dict, Any

def load_eval_stats(model_dir: Path) -> Dict[str, Any]:
    """加载单个模型的评估统计"""
    stats_file = model_dir / "eval_stats.json"
    if not stats_file.exists():
        return None
    
    with open(stats_file, 'r') as f:
        return json.load(f)

def generate_leaderboard(base_dir: str) -> str:
    """生成排行榜 Markdown 内容"""
    base_path = Path(base_dir)
    
    if not base_path.exists():
        print(f"Error: Directory not found: {base_dir}")
        sys.exit(1)
    
    results = []
    
    # 收集所有模型的结果
    for model_dir in sorted(base_path.iterdir()):
        if not model_dir.is_dir():
            continue
        
        stats = load_eval_stats(model_dir)
        if stats is None:
            continue
        
        model_name = model_dir.name.replace('_1', '').replace('_2', '').replace('_3', '')
        
        result = {
            'model': model_name,
            'total': stats['total_tasks'],
            'passed': stats['status_breakdown']['evaluation']['pass_count'],
            'failed': stats['status_breakdown']['evaluation']['fail_count'],
            'success_rate': stats['average_success_rate'] * 100,
            'avg_turns': stats['average_turns'],
            'avg_tool_calls': stats['average_tool_calls'],
        }
        
        results.append(result)
    
    # 按成功率降序排序
    results.sort(key=lambda x: x['success_rate'], reverse=True)
    
    # 生成 Markdown
    md_lines = []
    md_lines.append("# Toolathlon Leaderboard")
    md_lines.append("")
    md_lines.append(f"**Last Updated**: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    md_lines.append("")
    md_lines.append("## Overall Rankings")
    md_lines.append("")
    md_lines.append("| Rank | Model | Total | Passed | Failed | Success Rate | Avg Turns | Avg Tool Calls |")
    md_lines.append("|------|-------|-------|--------|--------|--------------|-----------|----------------|")
    
    for i, result in enumerate(results, 1):
        md_lines.append(
            f"| {i} | {result['model']} | {result['total']} | {result['passed']} | "
            f"{result['failed']} | {result['success_rate']:.2f}% | "
            f"{result['avg_turns']:.2f} | {result['avg_tool_calls']:.2f} |"
        )
    
    md_lines.append("")
    md_lines.append("## Performance Metrics")
    md_lines.append("")
    md_lines.append("### Success Rate Distribution")
    md_lines.append("")
    
    # 成功率分布
    rate_buckets = {
        '80%+': 0,
        '70-80%': 0,
        '60-70%': 0,
        '50-60%': 0,
        '<50%': 0
    }
    
    for result in results:
        rate = result['success_rate']
        if rate >= 80:
            rate_buckets['80%+'] += 1
        elif rate >= 70:
            rate_buckets['70-80%'] += 1
        elif rate >= 60:
            rate_buckets['60-70%'] += 1
        elif rate >= 50:
            rate_buckets['50-60%'] += 1
        else:
            rate_buckets['<50%'] += 1
    
    for bucket, count in rate_buckets.items():
        md_lines.append(f"- **{bucket}**: {count} models")
    
    md_lines.append("")
    md_lines.append("---")
    md_lines.append("")
    md_lines.append("*Generated from Toolathlon evaluation results*")
    
    return '\n'.join(md_lines)

def main():
    if len(sys.argv) < 2:
        print("Usage: python generate_leaderboard.py <dumps_directory> [output.md]")
        print("Example: python generate_leaderboard.py dumps_finalexp/ leaderboard.md")
        sys.exit(1)
    
    base_dir = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) > 2 else "leaderboard.md"
    
    leaderboard_md = generate_leaderboard(base_dir)
    
    # 保存到文件
    with open(output_file, 'w') as f:
        f.write(leaderboard_md)
    
    print(f"Leaderboard generated: {output_file}")
    print()
    print(leaderboard_md)

if __name__ == '__main__':
    main()
```

