# 评估逻辑（简化）
def validate_csv_data(agent_csv, expected_csv, tolerance=0.05):
    agent_data = read_csv(agent_csv)
    expected_data = read_csv(expected_csv)
    
    # 检查行数和列名
    if len(agent_data) != len(expected_data):
        raise ValueError("Row count mismatch")
    
    # 逐行对比数值（允许误差）
    for i in range(len(agent_data)):
        for column in expected_data.columns:
            expected_val = expected_data[i][column]
            agent_val = agent_data[i][column]
            
            if abs(agent_val - expected_val) > tolerance:
                raise ValueError(f"Value mismatch at row {i}, column {column}")
    
    return True
```

