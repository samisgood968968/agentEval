# 评估逻辑（简化）
def evaluate_paper_checker(agent_workspace, groundtruth_workspace):
    agent_files = extract_files(agent_workspace)
    gt_files = extract_files(groundtruth_workspace)
    
    # 逐文件对比内容
    for filename in gt_files:
        if filename not in agent_files:
            return False, f"Missing file: {filename}"
        
        agent_content = read_file(agent_files[filename])
        gt_content = read_file(gt_files[filename])
        
        if agent_content != gt_content:
            return False, f"Content mismatch in {filename}"
    
    return True, "All files match perfectly"
