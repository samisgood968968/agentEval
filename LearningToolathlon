# 写入 CSV 表头
echo "task,status,evaluation_pass,total_turns,tool_calls,prompt_tokens,completion_tokens,total_cost" > "$OUTPUT_FILE"

# 遍历所有任务
for task_dir in $DUMP_PATH/finalpool/*/; do
    task_name=$(basename "$task_dir")
    
    # 读取 status.json
    if [ -f "$task_dir/status.json" ]; then
        running_status=$(jq -r '.running // "null"' "$task_dir/status.json")
    else
        running_status="null"
    fi
    
    # 读取 eval_res.json
    if [ -f "$task_dir/eval_res.json" ]; then
        eval_pass=$(jq -r '.pass // "null"' "$task_dir/eval_res.json")
    else
        eval_pass="null"
    fi
    
    # 读取 traj_log.json
    if [ -f "$task_dir/traj_log.json" ]; then
        total_turns=$(jq -r '.key_stats.total_turns // 0' "$task_dir/traj_log.json")
        tool_calls=$(jq -r '.key_stats.tool_calls // 0' "$task_dir/traj_log.json")
        prompt_tokens=$(jq -r '.agent_cost.prompt_tokens // 0' "$task_dir/traj_log.json")
        completion_tokens=$(jq -r '.agent_cost.completion_tokens // 0' "$task_dir/traj_log.json")
